{
  "name": "@uxe/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && echo 'api: type-checked (runs via tsx / wrangler)'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@uxe/auth": "workspace:*",
    "@uxe/contracts": "workspace:*",
    "@uxe/db": "workspace:*",
    "@uxe/observability": "workspace:*",
    "@uxe/rag": "workspace:*",
    "hono": "4.13.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@uxe/config": "workspace:*",
    "@types/node": "22.19.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  }
}
