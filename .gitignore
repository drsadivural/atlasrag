# dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.egg-info/

# build output
dist/
build/
.output/
.wrangler/
storybook-static/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example
*.pem
!tests/fixtures/**/*.pem

# test artifacts
coverage/
playwright-report/
test-results/
blob-report/
tests/**/.auth/
artifacts/screenshots/actual/
artifacts/screenshots/diff/
# Run output, not deliverables. `.auth` holds a live session cookie: never commit it.
artifacts/.auth/
artifacts/test-results/
artifacts/a11y-results/
artifacts/playwright-report/
artifacts/a11y-report/
artifacts/coverage/

# Customer documents dropped in for a specific investigation. They are somebody's
# confidential filings, and one of them is 142 MB — neither belongs in version control.
docs/*.pdf

# local runtime data
.data/
storage-local/
*.log
.DS_Store
.scratch/

# Agent worktrees: full checkouts of this repo, owned by another session.
.claude/worktrees/
