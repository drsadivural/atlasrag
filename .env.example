# ---------------------------------------------------------------------------
# UXE Consulting AI — environment variables
# Copy to .env and fill in. NEVER commit a real .env file.
# Variables marked [server] must never be exposed to the browser bundle.
# ---------------------------------------------------------------------------

# --- Core runtime -----------------------------------------------------------
NODE_ENV=development                      # development | test | production
APP_ENV=development                       # development | staging | production
API_PORT=8787                             # Port for the Node adapter of the API worker
API_HOST=0.0.0.0                          # Bind address; narrow to 127.0.0.1 behind a proxy
WEB_PORT=5173                             # Vite dev server port
PUBLIC_APP_URL=http://localhost:5173      # Canonical browser origin, used for links in email
PUBLIC_API_URL=http://localhost:8787      # Browser-visible API origin
CORS_ALLOWED_ORIGINS=http://localhost:5173  # Comma-separated exact origins allowed to call the API

# --- Database ---------------------------------------------------------------
# [server] PostgreSQL 16+ with the pgvector extension available.
DATABASE_URL=postgres://uxe:uxe_dev_password@127.0.0.1:55432/uxe_dev
# [server] Separate database used by the integration test suite (dropped/recreated per run).
TEST_DATABASE_URL=postgres://uxe:uxe_dev_password@127.0.0.1:55432/uxe_test
DATABASE_MAX_CONNECTIONS=10
# In production on Cloudflare Workers this is provided by the Hyperdrive binding
# instead of a URL; see infra/cloudflare/wrangler.api.toml.

# --- Secrets ----------------------------------------------------------------
# [server] 32+ byte random strings. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-value-min-32-bytes
CSRF_SECRET=replace-me-with-a-different-long-random-value
# [server] Encrypts provider API keys and connector tokens at rest (AES-256-GCM).
# Must be exactly 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-base64-encoded-32-byte-key

# --- Object storage (Cloudflare R2 / any S3-compatible) ---------------------
STORAGE_DRIVER=filesystem                 # filesystem | s3   (filesystem is for local dev only)
STORAGE_LOCAL_PATH=./.data/storage        # Used when STORAGE_DRIVER=filesystem
S3_ENDPOINT=                              # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_ORIGINALS=uxe-originals         # Immutable uploaded source bytes
S3_BUCKET_ARTIFACTS=uxe-artifacts         # Generated reports / corrected documents
S3_ACCESS_KEY_ID=                         # [server]
S3_SECRET_ACCESS_KEY=                     # [server]
SIGNED_URL_TTL_SECONDS=300                # Lifetime of download links handed to the browser

# --- Document worker --------------------------------------------------------
DOCUMENT_WORKER_URL=http://127.0.0.1:8099
# [server] Shared secret presented by the API as the X-Worker-Token header.
DOCUMENT_WORKER_TOKEN=replace-me-with-a-shared-worker-secret
DOCUMENT_WORKER_TIMEOUT_MS=180000

# --- Model providers --------------------------------------------------------
# The default provider is `deterministic`: a fully local, extractive engine that
# grounds every sentence in a verified source excerpt. It needs no credentials and
# is what the test suite runs against. Configure a hosted provider to enable
# abstractive drafting; keys are stored encrypted per workspace via the UI too.
MODEL_PROVIDER=deterministic              # deterministic | anthropic | openai
ANTHROPIC_API_KEY=                        # [server]
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
OPENAI_API_KEY=                           # [server]
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=deterministic          # deterministic | openai
EMBEDDING_DIMENSIONS=768                  # Must match the vector column width in migrations

# --- Email ------------------------------------------------------------------
EMAIL_DRIVER=console                      # console | resend | smtp
# Unset follows EMAIL_DRIVER: no confirmation gate when mail cannot actually be delivered.
REQUIRE_EMAIL_VERIFICATION=
EMAIL_FROM="UXE Consulting AI <no-reply@example.com>"
RESEND_API_KEY=                           # [server]
SMTP_URL=                                 # [server] smtps://user:pass@host:465

# --- OAuth (optional; sign-in buttons hide themselves when unset) -----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=               # [server]
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=            # [server]
MICROSOFT_OAUTH_TENANT=common

# --- Ingestion safety limits ------------------------------------------------
MAX_UPLOAD_BYTES=524288000                # 500 MB per file
MAX_ARCHIVE_ENTRIES=2000                  # ZIP bomb guard: entry count
MAX_ARCHIVE_EXPANDED_BYTES=2147483648     # ZIP bomb guard: total expanded size
MAX_ARCHIVE_COMPRESSION_RATIO=120         # ZIP bomb guard: expanded/compressed ratio
MAX_DOCUMENT_PAGES=5000
URL_INGEST_ALLOWED_SCHEMES=https          # SSRF guard
URL_INGEST_BLOCK_PRIVATE_NETWORKS=true    # SSRF guard: refuse RFC1918 / link-local / loopback
CRAWL_MAX_PAGES=200
CRAWL_MAX_DEPTH=3

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_DRIVER=memory                  # memory | kv   (Workers KV in production)
RATE_LIMIT_LOGIN_PER_15M=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_UPLOAD_PER_HOUR=200
RATE_LIMIT_CONSULT_PER_HOUR=120

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=json                           # json | pretty
OTEL_EXPORTER_OTLP_ENDPOINT=              # e.g. https://otlp.example.com
OTEL_SERVICE_NAME=uxe-api
SENTRY_DSN=                               # [server]
TRACE_SAMPLE_RATE=1.0
# When true, excerpt text may appear in debug logs. Keep false outside local dev.
LOG_DOCUMENT_CONTENT=false

# --- Retention --------------------------------------------------------------
DEFAULT_RETENTION_DAYS=365
PURGE_GRACE_PERIOD_DAYS=30

# Extra hostnames the web server answers to, comma separated. Needed when it runs
# behind a reverse proxy or a tunnel, where the Host header is the public name.
WEB_ALLOWED_HOSTS=
# user:password. Locks the hostnames named above behind HTTP basic auth; leave empty for
# no lock. A stopgap for a staging environment on the public internet, not a real control.
WEB_BASIC_AUTH=
